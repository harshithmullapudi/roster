{
  "name": "roster",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter @roster/db migrate && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:push": "pnpm --filter @roster/db push",
    "db:generate": "pnpm --filter @roster/db generate",
    "db:studio": "pnpm --filter @roster/db studio",
    "release:cli": "turbo build test --filter @redplanethq/roster-cli && pnpm --filter @redplanethq/roster-cli publish --access public --no-git-checks",
    "dev:db": "docker compose -f docker-compose.dev.yaml up -d",
    "dev:db:stop": "docker compose -f docker-compose.dev.yaml down",
    "perf:message-lag": "node scripts/perf/message-lag-repro.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.49.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
